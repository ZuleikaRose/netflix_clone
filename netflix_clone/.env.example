# Copy to .env.development.local (dev project: `npm run dev` and the e2e tests) and .env.production.local
# (production project: `npm run build`), filled in from the Supabase dashboard → Connect.
# Leave them out to run on the built-in catalog and in-memory accounts with no backend (CI does this).
# Use the publishable key (sb_publishable_…), never the secret / service_role key: every VITE_ value reaches the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: `memory` keeps accounts in memory even when Supabase is configured (the main e2e build sets this)
VITE_AUTH_BACKEND=
# Optional: Stripe's publishable key (pk_test_… on dev) turns on /donate. Never put a Stripe sk_… key in any VITE_ value.
VITE_STRIPE_PUBLISHABLE_KEY=
