# Copy to .env.local and fill in from the Supabase dashboard → Connect (or Settings → API Keys).
# Leave both empty to run the app on its built-in catalog with no backend (CI does this).
# Use the publishable key (sb_publishable_…), never the secret / service_role key: every VITE_ value reaches the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
