# Copy to .env.production.local (production project: `npm run build`), filled in from the Supabase dashboard → Connect.
# There's no development project any more (eagle_platoon_dev was deleted on 2026-10-31): leave .env.development.local
# out, so `npm run dev` and the e2e tests use the built-in catalog. Never put production's values in it, or the
# Supabase e2e specs create real accounts in production.
# Leave them out to run on the built-in catalog and in-memory accounts with no backend (CI does this).
# Use the publishable key (sb_publishable_…), never the secret / service_role key: every VITE_ value reaches the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: `memory` keeps accounts in memory even when Supabase is configured (the main e2e build sets this)
VITE_AUTH_BACKEND=
# Optional: Stripe's publishable key (pk_live_… in production) turns on /donate. Never put a Stripe sk_… key in any VITE_ value.
VITE_STRIPE_PUBLISHABLE_KEY=
