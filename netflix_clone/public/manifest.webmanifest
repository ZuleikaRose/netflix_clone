{
  "name": "Netflix Clone",
  "short_name": "Netflix Clone",
  "description": "Watch, list and share movies and TV shows, with games, watch parties and full accessibility settings.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090909",
  "theme_color": "#090909",
  "categories": ["entertainment"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "/search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My List", "url": "/watchlist", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
